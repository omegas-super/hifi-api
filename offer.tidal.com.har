 Student Account\",\"yourFullName\":\"Your full name\"},\"success\":{\"liveFlow\":{\"copy\":\"Get the TIDAL app and log in - we\\'ll take you right back to {username}\\'s session.\"}},\"successFlowPage\":{\"accessTierMessage\":\"You are currently on a free TIDAL Access plan which is limited to playback of TIDAL\\'s live video channels.\",\"confirmBtn\":\"Yes, please\",\"confirmationEmailSent\":\"A confirmation email has been sent to\",\"denyBtn\":\"I don\\'t want updates\",\"getStartedTitle\":\"Get started\",\"message\":\"Download the app to access exclusive releases, livestreams, videos & more\",\"newsletterMessage\":\"Do you want to receive emails and other communications from TIDAL, including news about the service, new content and events?\",\"subtitle\":\"Your account is now activated\",\"title\":\"Welcome!\"},\"successPage\":{\"message\":\"You may now close this window and start using your TIDAL account.\",\"title\":\"Success\"},\"voucher\":{\"buyGiftCardBtn\":\"Buy Gift Card\",\"buyGiftCardText\":\"Looking to buy a gift card?\",\"click\":\"Click the button below.\",\"countryNotEligible\":\"This voucher cannot be redeemed in your country.\",\"dontHaveCode\":\"Don\\'t have a code?\",\"giftCardAmountRedeemed\":\"was added to your wallet.<br>When this runs out, we’ll use your default payment method for future billing.\",\"giftCardRedeemed\":\"Gift card redeemed\",\"lilUziVert2020\":\"Enter your code to create your account and access<br>Lil Uzi Vert Live on August 27th at 6pm ET / 3pm PT.\",\"meganTheeStallionLive_copy\":\"Enter your code to create your account and access<br>Megan Thee Stallion Live on August 29th at 6pm ET / 3pm PT / 11pm BST.\",\"messageCTAReactivate\":\"Reactivate your subscription by selecting a plan.\",\"messageCTASubscription\":\"Complete your registration by selecting a plan and adding your payment details.\",\"noProblem\":\"No problem. Click the button below to try TIDAL free for 30 days.\",\"notEligibleForCode\":\"You are not eligible to u