\"isThirdParty\":false},{\"id\":\"deb70526-1c2b-4596-ad02-b56139b7128a\",\"Name\":\"ts_c\",\"Host\":\"paypal.com\",\"IsSession\":false,\"Length\":\"390\",\"description\":\"This cookie is provided by Paypal. The cookie is used to enable transactions on our websites. The cookie is necessary for secure transactions.\",\"thirdPartyDescription\":\"\",\"patternKey\":null,\"thirdPartyKey\":null,\"firstPartyKey\":null,\"DurationType\":30,\"category\":null,\"isThirdParty\":false},{\"id\":\"17ec2a0d-cf7e-4d71-a226-c0ba170ea657\",\"Name\":\"LANG\",\"Host\":\"paypal.com\",\"IsSession\":true,\"Length\":\"0\",\"description\":\"This cookie is provided by Paypal. The cookie is used to enable transactions on our websites. The cookie is necessary for secure transactions.\",\"thirdPartyDescription\":\"\",\"patternKey\":null,\"thirdPartyKey\":null,\"firstPartyKey\":null,\"DurationType\":1,\"category\":null,\"isThirdParty\":false},{\"id\":\"e4439e5d-2146-4d76-b78c-efd52a3212f5\",\"Name\":\"nsid\",\"Host\":\"paypal.com\",\"IsSession\":true,\"Length\":\"0\",\"description\":\"This cookie is provided by Paypal. The cookie is used to enable transactions on our websites. The cookie is necessary for secure transactions.\",\"thirdPartyDescription\":\"\",\"patternKey\":null,\"thirdPartyKey\":null,\"firstPartyKey\":null,\"DurationType\":1,\"category\":null,\"isThirdParty\":false},{\"id\":\"4af58766-315d-477c-9fca-bb7d89ce87ea\",\"Name\":\"tsrce\",\"Host\":\"paypal.com\",\"IsSession\":true,\"Length\":\"0\",\"description\":\"This cookie is provided by Paypal. The cookie is used to enable transactions on our websites. The cookie is necessary for secure transactions.\",\"thirdPartyDescription\":\"\",\"patternKey\":null,\"thirdPartyKey\":null,\"firstPartyKey\":null,\"DurationType\":1,\"category\":null,\"isThirdParty\":false},{\"id\":\"f4dcaf9c-320a-418a-95d9-c6c8048194b2\",\"Name\":\"enforce_policy\",\"Host\":\"paypal.com\",\"IsSession\":false,\"Length\":\"365\",\"description\":\"This cookie is provided by Paypal. The cookie is used to enable transactions on our websites. The cookie is necessary for secure transactions.\",\"thirdPartyDescription\":\"\",\"patternKey\":null,\"thirdPartyKey\":null,\"firstPartyKey\":null,\"DurationType\":365,\"category\":null,\"isThirdParty\":false}]},{\"HostName\":\"tidal.com\",\"DisplayName\":\"tidal.com\",\"HostId\":\"H17\",\"Description\":\"\",\"PrivacyPolicy\":\"\",\"Cookies\":[{\"id\":\"019c8efe-e965-7ea5-9a0e-c429556c4ffb\",\"Name\":\"__stripe_mid\",\"Host\":\"tidal.com\",\"IsSession\":false,\"Length\":\"365\",\"description\":\"Cookie associated with Stripe, payment service provider. Set for fraud prevention purposes and helps us assess the risk associated with an attempted transaction.\",\"thirdPartyDescription\":\"\",\"patternKey\":null,\"thirdPartyKey\":null,\"firstPartyKey\":null,\"DurationType\":365,\"category\":null,\"isThirdParty\":false},{\"id\":\"019c8f00-e0a2-7aa5-b495-19e8e2a79a0e\",\"Name\":\"__stripe_sid\",\"Host\":\"tidal.com\",\"IsSession\":true,\"Length\":\"0\",\"description\":\"Cookie associated with Stripe, payment service provider. Set for fraud prevention purposes and helps us assess the risk associated with an attempted transaction.\",\"thirdPartyDescription\":\"\",\"patternKey\":null,\"thirdPartyKey\":null,\"firstPartyKey\":null,\"DurationType\":1,\"category\":null,\"isThirdParty\":false}]}],\"PurposeId\":\"9F6F23FB-5059-4E19-A515-85EAE0F508A8\",\"CustomGroupId\":\"C0001\",\"GroupId\":\"7f634e79-add8-44a7-b144-5211ce46c7f8\",\"Status\":\"always active\",\"IsDntEnabled\":false,\"Type\":\"COOKIE\",\"DescriptionLegal\":\"\",\"IabIllustrations\":[],\"HasLegIntOptOut\":false,\"HasConsentOptOut\":true,\"IsGpcEnabled\":false,\"VendorServices\":null,\"TrackingTech\":null},{\"ShowInPopup\":true,\"ShowInPopupNonIAB\":true,\"ShowSDKListLink\":true,\"Order\":\"2\",\"OptanonGroupId\":\"C0004\",\"Parent\":\"\",\"ShowSubgroup\":true,\"ShowSubGroupDescription\":true,\"ShowSubgroupToggle\":false,\"AlwaysShowCategory\":false,\"GroupDescription\":\"These cookies are used to build a profile of your interests and to show you relevant targeted ads on and off our websites, applications or third-party sites. These cookies are also used to limit the number of times you see an ad as well as help us measure the effectiveness and performance of our ad campaigns, enable ad conversion tracking and ad billing. By accepting these cookies, you consent to use of cookies for these purposes, and direct TIDAL to disclose your personal data with our ad partners for the above purposes.\",\"GroupDescriptionOTT\":\"These cookies are used to build a profile of your interests and to show you relevant targeted ads on and off our websites, applications or third-party sites. These cookies are also used to limit the number of times you see an ad as well as help us measure the effectiveness and performance of our ad campaigns, enable ad conversion tracking and ad billing. By accepting these cookies, you consent to use of cookies for these purposes, and direct TIDAL to disclose your personal data with our ad partners for the above purposes.\",\"GroupNameMobile\":\"Targeting (Advertising) Cookies\",\"GroupNameOTT\":\"Targeting (Advertising) Cookies\",\"GroupName\":\"Targeting (Advertising) Cookies\",\"IsIabPurpose\":false,\"GeneralVendorsIds\":[],\"FirstPartyCookies\":[{\"id\":\"db4dad01-0cd3-46a7-acfb-64f0cd44f856\",\"Name\":\"_fbp\",\"Host\":\"tidal.com\",\"IsSession\":false,\"Length\":\"89\",\"description\":\"Used by Facebook to deliver a series of advertisement products such as real time bidding from third party advertisers\",\"thirdPartyDescription\":null,\"patternKey\":null,\"thirdPartyKey\":\"\",\"firstPartyKey\":\"Cookie_fbp\",\"DurationType\":1,\"category\":null,\"isThirdParty\":false},{\"id\":\"0199f14c-3c71-74dd-b0bd-9800d1b802cf\",\"Name\":\"_rdt_uuid\",\"Host\":\"offer.tidal.com\",\"IsSession\":false,\"Length\":\"89\",\"description\":\"This cookie is set by Reddit and is used for tracking the views of