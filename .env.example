CLIENT_ID=
CLIENT_SECRET=
USER_ID=
REFRESH_TOKEN=
COUNTRY_CODE=
# --- Oxaam account-based auto-login (recommended) ---
# Set YOUR Oxaam account email and password. The app will:
#   1. Log into oxaam.com at startup
#   2. Scrape the Tidal (Tiedla) shared account credentials automatically
#   3. Use them to get a Tidal refresh_token via password grant
#   4. Cache the token in token.json (no Oxaam hit on next restart)
#   5. Self-heal: if the token is revoked, it re-fetches from Oxaam automatically
OXAAM_EMAIL=
OXAAM_PASSWORD=
USE_PROXIES=False
ROTATE_PROXIES_ON_REFRESH=False
PROXIES_FILE=proxies.txt
MAX_RETRIES=2
# WARNING: If set to True, the app will expose the host IP if all proxies fail or proxies.txt is misconfigured!
FALLBACK_TO_DIRECT_CONNECTION=False
# Override the User-Agent sent to Tidal
# USER_AGENT=okhttp/5.3.2
# Enable verbose logging of every upstream request (status, headers, body)
# DEV_MODE=True
